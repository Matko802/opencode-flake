#!/usr/bin/env bash
pkgname="@opencode/cli"
version="@version@"
if [ "$#" -eq 4 ] && [ "$1" = "list" ] && [ "$2" = "-g" ] && [ "$3" = "--depth=0" ] && [ "$4" = "$pkgname" ]; then
  echo "$pkgname@$version"
  exit 0
fi
last="${@:$#}"
if [ "${1:-}" = "install" ] && [ "${2:-}" = "--global" ]; then
  case "$last" in
    "$pkgname"|"$pkgname"@*) exec "@out@/libexec/upgrade" "$last" ;;
  esac
fi
if [ "${1:-}" = "uninstall" ] && [ "${2:-}" = "--global" ] && [ "$last" = "$pkgname" ]; then
  exec "@out@/libexec/upgrade" remove
fi
oldifs=$IFS
IFS=:
for dir in $PATH; do
  if [ "$dir" != "@out@/bin" ] && [ -x "$dir/npm" ]; then
    IFS=$oldifs
    exec "$dir/npm" "$@"
  fi
done
IFS=$oldifs
echo "npm: no npm found on PATH outside the opencode wrapper" >&2
exit 127
