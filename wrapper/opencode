#!/usr/bin/env bash
set -euo pipefail

api="${OPENCODE_UPDATE_API:-https://opencode.ai/update/api/latest/cli/npm}"
home="${OPENCODE_HOME:-${HOME:?}/.opencode}"
bin="$home/bin/opencode"
version_file="$home/version"
loader="${OPENCODE_NIX_LOADER:-}"

say() {
  printf 'opencode: %s\n' "$*" >&2
}

is_on() {
  case "${1:-}" in
    1|true|yes|on) return 0 ;;
    *) return 1 ;;
  esac
}

latest_version() {
  local metadata
  metadata="$(curl -fsSL --connect-timeout 2 --max-time 5 "$api" 2>/dev/null || true)"
  printf '%s' "$metadata" | sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p'
}

package_scope() {
  local metadata package
  metadata="$(curl -fsSL --connect-timeout 2 --max-time 5 "$api" 2>/dev/null || true)"
  package="$(printf '%s' "$metadata" | sed -n 's/.*"package"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
  package="${package:-@opencode/cli}"
  printf '%s\n' "${package%/cli}"
}

installed_version() {
  local detected
  if [ ! -x "$bin" ]; then return 1; fi
  if [ -s "$version_file" ]; then
    head -n1 "$version_file"
    return 0
  fi
  detected="$("$bin" --version 2>/dev/null | grep -oE '[0-9]+(\.[0-9]+)+' | head -n1 || true)"
  if [ -z "$detected" ]; then return 1; fi
  mkdir -p "$home"
  printf '%s\n' "$detected" > "$version_file" 2>/dev/null || true
  printf '%s\n' "$detected"
}

version_gt() {
  [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n1)" = "$1" ]
}

target_name() {
  local arch target
  case "$(uname -m)" in
    x86_64|amd64) arch=x64 ;;
    aarch64|arm64) arch=arm64 ;;
    *) say "unsupported architecture $(uname -m)"; return 1 ;;
  esac
  target="linux-$arch"
  if [ "$arch" = x64 ] && ! grep -qwi avx2 /proc/cpuinfo 2>/dev/null; then
    target="$target-baseline"
  fi
  if [ -f /etc/alpine-release ]; then
    target="$target-musl"
  fi
  printf '%s\n' "$target"
}

download() {
  local url="$1" output="$2"
  if [ -t 2 ]; then
    curl -fL --progress-bar --connect-timeout 10 -o "$output" "$url"
  else
    curl -fsSL --connect-timeout 10 -o "$output" "$url"
  fi
}

install_version() (
  set -euo pipefail
  version="${1:-}"
  version="${version#v}"
  case "$version" in
    ""|*[!0-9A-Za-z.+-]*) say "invalid version '$version'"; exit 1 ;;
  esac
  scope="$(package_scope)"
  target="$(target_name)"
  url="https://registry.npmjs.org/${scope}/cli-${target}/-/cli-${target}-${version}.tgz"
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/opencode.XXXXXX")"
  trap 'rm -rf "$tmp"' EXIT
  say "installing opencode ${version}"
  if ! download "$url" "$tmp/opencode.tgz"; then
    say "failed to download ${url}"
    exit 1
  fi
  if ! tar -xzf "$tmp/opencode.tgz" -C "$tmp"; then
    say "failed to extract ${url}"
    exit 1
  fi
  rm -f "$tmp/opencode.tgz"
  new="$tmp/package/bin/opencode"
  if [ ! -f "$new" ]; then
    say "${url} did not contain package/bin/opencode"
    exit 1
  fi
  chmod 755 "$new"
  if ! "$new" --version >/dev/null 2>&1; then
    if [ -n "$loader" ] && command -v patchelf >/dev/null 2>&1; then
      if ! patchelf --set-interpreter "$loader" "$new"; then
        say "failed to patch the dynamic loader"
        exit 1
      fi
    fi
  fi
  if ! "$new" --version >/dev/null 2>&1; then
    say "downloaded opencode ${version} does not run"
    exit 1
  fi
  mkdir -p "$home/bin"
  if ! install -m755 "$new" "$home/bin/.opencode.new"; then
    say "failed to write to ${home}/bin"
    exit 1
  fi
  mv -f "$home/bin/.opencode.new" "$bin"
  printf '%s\n' "$version" > "$version_file"
  say "opencode ${version} installed in ${home}"
)

usage() {
  cat >&2 <<'EOF'
usage: opencode-manager <command> [version]

commands:
  status            show installed and latest versions
  update [version]  install the latest or a specific version
  check             print the latest version; exit 0 if an update is available
  version           print the installed version
  path              print the installed binary path
  help              show this help
EOF
}

if [ -n "${OPENCODE_MANAGER_MODE:-}" ]; then
  cmd="${1:-status}"
  case "$cmd" in
    status)
      installed="$(installed_version || true)"
      latest="$(latest_version)"
      printf 'home: %s\n' "$home"
      printf 'installed: %s\n' "${installed:-not installed}"
      printf 'latest: %s\n' "${latest:-unknown}"
      if [ -n "$installed" ] && [ -n "$latest" ]; then
        if version_gt "$latest" "$installed"; then
          printf 'update: available (%s -> %s)\n' "$installed" "$latest"
        else
          printf 'update: none\n'
        fi
      fi
      ;;
    update|install)
      target="${2:-latest}"
      if [ "$target" = "latest" ]; then
        target="$(latest_version)"
        if [ -z "$target" ]; then
          say "could not determine the latest version"
          exit 1
        fi
      fi
      install_version "$target"
      ;;
    check)
      installed="$(installed_version || true)"
      latest="$(latest_version)"
      if [ -z "$latest" ]; then
        say "could not determine the latest version"
        exit 2
      fi
      printf '%s\n' "$latest"
      if [ -n "$installed" ] && ! version_gt "$latest" "$installed"; then
        exit 1
      fi
      exit 0
      ;;
    version)
      installed_version || { printf 'not installed\n'; exit 1; }
      ;;
    path)
      printf '%s\n' "$bin"
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      usage
      exit 1
      ;;
  esac
  exit 0
fi

installed="$(installed_version || true)"

if [ -z "$installed" ]; then
  latest="$(latest_version)"
  if [ -z "$latest" ]; then
    say "opencode is not installed and the latest version could not be determined"
    exit 1
  fi
  install_version "$latest"
  installed="$latest"
fi

case "${1:-}" in
  -v|--version|-h|--help)
    export OPENCODE_MANAGER_CHILD=1
    export OPENCODE_DISABLE_AUTOUPDATE=1
    exec "$bin" "$@"
    ;;
esac

if [ -z "${OPENCODE_MANAGER_CHILD:-}" ] && ! is_on "${OPENCODE_NO_UPDATE:-}"; then
  if [ -t 0 ] || is_on "${OPENCODE_AUTO_UPDATE:-}"; then
    latest="$(latest_version)"
    if [ -n "$latest" ] && version_gt "$latest" "$installed"; then
      do_update=0
      if is_on "${OPENCODE_AUTO_UPDATE:-}"; then
        do_update=1
      elif [ -t 0 ] && [ -t 2 ]; then
        printf 'opencode %s is available (installed %s). Update? [y/N] ' "$latest" "$installed" >&2
        answer=""
        read -r answer || answer=""
        case "$answer" in [yY]*) do_update=1 ;; esac
      fi
      if [ "$do_update" = "1" ]; then
        if install_version "$latest"; then
          installed="$latest"
        else
          say "update failed; continuing with ${installed}"
        fi
      fi
    fi
  fi
fi

export OPENCODE_MANAGER_CHILD=1
export OPENCODE_DISABLE_AUTOUPDATE=1
exec "$bin" "$@"
